# Pinned environment variables for NVIDIA SkillEvaluator Tier 2 CI Spike

# Ollama Linux release. This is the only place the Ollama version is set: every workflow (Tier 2 and the release workflows)
# installs it through .github/tier2/install_ollama.sh. The sha256 is the digest GitHub shows for ollama-linux-amd64.tar.zst on
# the release page https://github.com/ollama/ollama/releases/tag/<OLLAMA_VERSION>. Changing the version can change the
# local manifest digests below, so re-pin those too when a Tier 2 run reports a mismatch.
OLLAMA_VERSION="v0.40.18"
OLLAMA_LINUX_AMD64_SHA256="b82649006cb5b54ed1237fa2d1a26a7f939a4fd03150033759acbff7ff315adf"

# GGUF Community Repository for Nemotron-3-Embed-1B
GGUF_REPO="NeoRoth/nemotron-3-embed-1b-gguf"
GGUF_REVISION="f84afc52469e77beb5cc9ca17b36fb2e76dca6f1"
GGUF_SHA256_Q8_0="58e41095862c50bc084bb8afa9b00e586733faaef2627d88c3e04da80d8d8e92"
GGUF_SHA256_F16="b808437186a493f6c89af374cc7094e64275e4559746e8dbe7d64f8c974c0d85"
GGUF_SHA256_Q4_K_M="3d112b61858b5671bde9dfc190f9577fa7ad1818a8a0c201bc74ed10b4f238a4"

# Official Upstream BF16 Model Repository
UPSTREAM_BF16_REPO="nvidia/Nemotron-3-Embed-1B-BF16"
UPSTREAM_BF16_REVISION="0677b2025cbc37daf92d7b9c7a225de8cfbc5b0b"

# Ollama LLM judges for dedup-scan.
# OLLAMA_LLM_MODEL is the first judge. OLLAMA_LLM_ALT_MODEL is a differently trained second judge: the PR workflow runs it only on the skills the first judge flagged, and a finding is raised only when both agree (locally: set SKILL_EVAL_LLM_MODEL and pass the tag as the second argument of setup_ollama.sh, or use pull_llm.sh).
# *_MANIFEST_DIGEST = sha256 of the local manifest file ~/.ollama/models/manifests/registry.ollama.ai/library/<name>/<tag>
# after `ollama pull`, observed in CI with Ollama v0.40.15 (manual Tier 2 runs on 2026-11-11). Re-pin from the 'Local manifest sha256:' line that setup_ollama.sh prints
# when a tag or the Ollama version changes.
OLLAMA_LLM_MODEL="granite4.1:3b"
OLLAMA_LLM_MANIFEST_DIGEST="59b95aeac3cf33b93391c475aa78a53230cdfb06ea1063485e4d28d6c48ae2a8"
OLLAMA_LLM_ALT_MODEL="phi4-mini:3.8b"
OLLAMA_LLM_ALT_MANIFEST_DIGEST="b9db5daa27583d278796ac1fceaa934d09d09b3688a82e5889d089535b8c7a38"
