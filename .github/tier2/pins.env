# Ollama LLM judges for dedup-scan.
# OLLAMA_LLM_MODEL is the default judge. OLLAMA_LLM_ALT_MODEL is a differently trained alternate for cross-checks (use it locally: set SKILL_EVAL_LLM_MODEL and pass the tag as the second argument of setup_ollama.sh).
# *_MANIFEST_DIGEST = sha256 of the local manifest file ~/.ollama/models/manifests/registry.ollama.ai/library/<name>/<tag>
# after `ollama pull`, observed in CI with Ollama v0.40.15 (manual Tier 2 runs on 2026-11-11). Re-pin from the 'Local manifest sha256:' line that setup_ollama.sh prints
# when a tag or the Ollama version changes.
OLLAMA_LLM_MODEL="granite4.1:3b"
OLLAMA_LLM_MANIFEST_DIGEST="59b95aeac3cf33b93391c475aa78a53230cdfb06ea1063485e4d28d6c48ae2a8"
OLLAMA_LLM_ALT_MODEL="phi4-mini:3.8b"
OLLAMA_LLM_ALT_MANIFEST_DIGEST="b9db5daa27583d278796ac1fceaa934d09d09b3688a82e5889d089535b8c7a38"
